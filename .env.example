# Copy this file to .env and adjust values as needed.
SECRET_KEY=change-this-to-a-random-secret
# Defaults to a local SQLite file under instance/ if not set.
# For MySQL/Postgres instead, e.g.:
# DATABASE_URL=mysql+pymysql://user:password@localhost/exam_proctoring
DATABASE_URL=
MAX_VIOLATIONS=5
FACE_MATCH_THRESHOLD=0.6

# Email (verification + password reset). Leave MAIL_SERVER blank to use the
# built-in dev fallback: emails are logged to instance/outbox.log and the
# link is flashed directly in the browser, so no SMTP setup is required to
# try the app out.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@exam-proctoring.local

# --- Exam Integrity Controls (app.security) ---
# Kick out any other active session for an account on a new login.
SINGLE_SESSION_PER_ACCOUNT=true
# Optional VPN/proxy detection on login via a third-party IP-reputation API.
# Off by default (no-ops if unconfigured or unreachable).
VPN_DETECTION_ENABLED=false
VPN_DETECTION_API_URL=
VPN_DETECTION_API_KEY=

# --- Plagiarism / Answer Similarity Detection (app.similarity) ---
SIMILARITY_THRESHOLD_DEFAULT=70

# --- Institution / Organization Management ---
# No env var here — organizations are created at registration (self-serve,
# admin role only) or via `flask create-super-admin` for the platform role.

# --- System Monitoring & Operations ---
# Platform-wide defaults for data retention (days) — an organization can
# override its own via /admin/retention, and a super_admin can override the
# platform default via /ops/retention. See app.retention.
RECORDING_RETENTION_DAYS=90
SNAPSHOT_RETENTION_DAYS=90
ENDED_LOGIN_SESSION_RETENTION_DAYS=180
LOGIN_SECURITY_EVENT_RETENTION_DAYS=180
ACTIVITY_LOG_RETENTION_DAYS=365
NOTIFICATION_LOG_RETENTION_DAYS=180
ERROR_LOG_RETENTION_DAYS=90

# Real-time system health alerts (app.alerting) — disk usage % and error
# count/window that trigger an alert, notified by email to every
# super_admin (or ALERT_EMAIL_OVERRIDE, comma-separated) and optionally
# posted to Slack.
DISK_USAGE_ALERT_THRESHOLD_PCT=90
ERROR_RATE_ALERT_THRESHOLD=10
ERROR_RATE_ALERT_WINDOW_MINUTES=15
ALERT_EMAIL_OVERRIDE=
SLACK_WEBHOOK_URL=

# --- Legal pages (app.legal) ---
# Bumping this doesn't retroactively do anything — it's just recorded
# against each user's consent so you can tell who agreed to which version.
TERMS_VERSION=2026-08-28

# --- Org-level branding (app.branding) ---
# Where uploaded org logos are stored on disk. Defaults to instance/org_branding.
ORG_BRANDING_DIR=
